    "trust_reviews": { "title": "60% of 'verified' reviews are fake", "body": "...", "statVisual": { "type": "comparison_bar", "labels": ["Real","Fake"], "values": [40, 60] } }
  },

  "analytics": {
    "exposureEvent": "dynamic_feature_info_viewed",
    "ctaEvent": "dynamic_feature_info_continued"
